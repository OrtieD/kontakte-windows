{
  "name": "kontakte",
  "productName": "Kontakte",
  "version": "1.1.4",
  "description": "Kontakte – Nachbau der Apple-Kontakte-App für Windows",
  "main": "main.js",
  "author": "Ortie",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "de.ortie.kontakte",
    "productName": "Kontakte",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kontakte-Setup-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "vcf",
        "name": "vCard",
        "description": "vCard-Kontakt"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "carddav.js",
      "src/**/*",
      "package.json"
    ],
    "portable": {
      "artifactName": "Kontakte-${version}-portable.exe"
    },
    "afterPack": "build/set-icon.js"
  }
}